{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run DriveScene Studio",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/dev.mjs",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "pattern": "DriveScene ready at (http://127\\.0\\.0\\.1:[0-9]+)",
        "uriFormat": "%s/?scene=20&view=driver&speed=90&trees=1",
        "action": "debugWithChrome",
        "webRoot": "${workspaceFolder}",
        "killOnServerStop": true
      }
    }
  ]
}
